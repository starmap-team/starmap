root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{vue,js,ts,tsx,jsx,mjs,cjs}]
indent_size = 2

[*.{json,yml,yaml,md}]
indent_size = 2

[*.py]
indent_size = 4
max_line_length = 120

[Makefile]
indent_style = tab