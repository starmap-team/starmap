# =============================================================================
# 星图(StarMap) 后端 开发镜像（热重载）
# =============================================================================
FROM python:3.11-slim

# 系统依赖（构建 psycopg、爬虫等需要）
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential libpq-dev curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# 先装 Poetry（版本锁定）
RUN pip install --no-cache-dir poetry==2.4.1

# 配置 Poetry：用虚拟环境在项目内，不创建独立 venv（容器内即可）
ENV POETRY_VIRTUALENVS_CREATE=false \
    POETRY_NO_INTERACTION=1 \
    POETRY_CACHE_DIR=/tmp/poetry_cache

# 先拷依赖文件，利用 Docker 层缓存
# 2026-08-25 (CI 修复): context=仓库根 (docker-compose.dev.yml) 时路径需 backend/ 前缀，
# 否则 "/pyproject.toml: not found" 导致 Docker 冒烟 CI 失败
COPY backend/pyproject.toml backend/poetry.lock* ./
RUN poetry install --no-root && rm -rf $POETRY_CACHE_DIR

# Crawler sync DB 驱动 — 显式安装（pyproject/lock 已含，但 poetry install 层缓存
# 可能在 psycopg 加入前构建导致镜像缺失；镜像内显式装一遍保证 API/worker 都能
# 经 crawler.persistence 写 jd_raw，2026-08-12 D5）
RUN pip install --no-cache-dir 'psycopg[binary]>=3.0'

# 再拷源码（挂载会覆盖，这里仅为镜像构建）
# 2026-08-25 (CI 修复): context=仓库根 → backend/ 前缀
COPY backend/ .
COPY backend/entrypoint.sh entrypoint.sh

# entrypoint: bootstrap.py (alembic upgrade + seed) then exec CMD
RUN chmod +x entrypoint.sh

EXPOSE 8000

# Bootstrap runs alembic upgrade + admin seed; docker-compose overrides CMD.
ENTRYPOINT ["./entrypoint.sh"]
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
