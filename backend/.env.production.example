# =============================================================================
# StarMap · Production Environment Template (backend/.env.production)
# =============================================================================
# ⚠️  DO NOT COMMIT real secrets. Copy this file to `.env.production`
# (which is in .gitignore) and replace every CHANGE_ME_* placeholder.
#
# Why a separate file?
#   - The root `.env` carries *development* defaults (`APP_ENV=development`,
#     `BOOTSTRAP_SEED_ADMIN=true`, weak `SECRET_KEY`, no Redis password).
#     Loading that file in prod made every `if app_env == "production"`
#     guard dormant (NEW-P0 in AUDIT_VERIFICATION §1.1).
#   - Loading `.env.production` instead flips those guards ON: anonymous
#     requests → 401, Swagger/ReDoc hidden, weak SECRET_KEY rejected,
#     Redis password enforced, debug mode rejected, bootstrap seed admin
#     refused.
#
# Required env vars (each maps to a startup assertion):
#   APP_ENV=production             ← flips all prod guards on
#   APP_DEBUG=false               ← (else RuntimeError)
#   SECRET_KEY=≥32 random chars   ← (else RuntimeError)
#   REDIS_URI=redis://:<pw>@…     ← must contain `@` (else RuntimeError)
#   BOOTSTRAP_SEED_ADMIN=false    ← never seed a weak admin in prod
#   POSTGRES_PASSWORD, NEO4J_PASSWORD ← strong, no CHANGE_ME_*
#
# Generate strong secrets:
#   openssl rand -hex 32
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# =============================================================================

# ──────────────── PostgreSQL ────────────────
POSTGRES_USER=starmap
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD_32CHARS_MIN
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=starmap
# W1-T7 (DATA-03): 生产必须 require / verify-ca / verify-full
POSTGRES_SSLMODE=require

# ──────────────── Neo4j ────────────────
# W1-T7 (DATA-02): 生产必须 bolt+s://
NEO4J_URI=bolt+s://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=CHANGE_ME_STRONG_PASSWORD_32CHARS_MIN

# ──────────────── Redis (must include :password@host) ────────────────
REDIS_PASSWORD=CHANGE_ME_STRONG_REDIS_PASSWORD_32CHARS_MIN
REDIS_URI=redis://:${REDIS_PASSWORD}@redis:6379/0

# ──────────────── ChromaDB ────────────────
CHROMA_HOST=chroma
CHROMA_PORT=8000

# ──────────────── LLM (≥1 must be configured) ────────────────
MIMO_API_BASE=https://token-plan-cn.xiaomimimo.com/v1
MIMO_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_API_KEY=
XUNFEI_API_KEY=
XUNFEI_API_SECRET=
XUNFEI_APP_ID=
QWEN_MODEL_PATH=http://ollama:11434

# ──────────────── Application ────────────────
APP_ENV=production
APP_DEBUG=false
APP_LOG_LEVEL=INFO

# 32+ random chars. Generate: openssl rand -hex 32
SECRET_KEY=CHANGE_ME_SECRET_KEY_AT_LEAST_32_CHARS_LONG_RANDOM

# ──────────────── CORS (comma-separated; no internal service names) ────────────────
CORS_ALLOWED_ORIGINS=https://starmap.example.com,https://www.starmap.example.com

# ──────────────── Bootstrap (NEVER enable in production) ────────────────
BOOTSTRAP_SEED_ADMIN=false
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_NO_DEFAULT_IN_PRODUCTION

# ──────────────── Dev bypass (NEVER enable in production) ────────────────
DEV_ANON_ADMIN=false