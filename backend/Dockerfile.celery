# StarMap celery-worker 镜像（Playwright + 反检测浏览器）
# PIPE-01: 基于 python:3.11-slim 自行安装 Playwright，避免上游镜像 Python 版本不匹配
FROM python:3.11-slim

# 系统依赖（psycopg build + Playwright 浏览器 + curl）
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential libpq-dev curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

ENV POETRY_VIRTUALENVS_CREATE=false \
    POETRY_NO_INTERACTION=1 \
    POETRY_CACHE_DIR=/tmp/poetry_cache \
    PYTHONUNBUFFERED=1

RUN pip install --no-cache-dir poetry==2.4.1

COPY backend/pyproject.toml backend/poetry.lock* ./
RUN poetry install --no-root && rm -rf $POETRY_CACHE_DIR

# Crawler dependencies (psycopg 用于 sync DB, scrapy/playwright 用于爬虫)
# 这些不被 poetry 跟踪，但 Celery worker 实际执行 crawl/import 阶段时需要
RUN pip install --no-cache-dir 'psycopg[binary]>=3.0'

# Playwright + Chromium（BOSS 爬虫反检测依赖，§10.1 PIPE-01）
RUN pip install --no-cache-dir playwright && \
    playwright install chromium && \
    playwright install-deps chromium

# 拷贝 crawler 包（Playwright-stealth BOSS 爬虫依赖）
COPY crawler/ ./crawler/

COPY backend/entrypoint.sh ./
RUN chmod +x entrypoint.sh
ENTRYPOINT ["./entrypoint.sh"]

# 默认启动 celery worker（具体 queues / beat 由 docker-compose 决定）
CMD ["celery", "-A", "app.tasks.celery_app.celery_app", "worker", "--loglevel=info"]
