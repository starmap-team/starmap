# StarMap Production Environment Template
# 复制本文件为 .env.production（不入仓），所有 ${VAR} 占位符由运维填入真实值。
# 生成密钥示例：python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# Public deployment 必读：
#   - 所有密钥经外部 secrets 注入（Vault / SSM / Docker secrets），避免散落仓库
#   - ${PUBLIC_DOMAIN} 由 scripts/deploy-public.sh 在部署时 sed 替换
#   - 9 项 config.py fail-fast 校验会自动拒绝未填的占位符

# === Database (PostgreSQL 16) ===
POSTGRES_USER=starmap
POSTGRES_PASSWORD=${POSTGRES_PASSWORD}
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=starmap
POSTGRES_SSLMODE=require

# === Graph (Neo4j 5-community, bolt+s TLS REQUIRED) ===
NEO4J_URI=bolt+s://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=${NEO4J_PASSWORD}

# === Cache (Redis 7, password required) ===
REDIS_PASSWORD=${REDIS_PASSWORD}
REDIS_URI=redis://:${REDIS_PASSWORD}@redis:6379/0

# === Vector store (Chroma) ===
CHROMA_HOST=chroma
CHROMA_PORT=8000

# === App runtime ===
APP_ENV=production
APP_DEBUG=false
APP_LOG_LEVEL=INFO

# === JWT (HS256 + kid keyring) ===
# 32 字符以上；轮换时新增 ${SECRET_KEY_NEW} 进 jwt_secret_keyring 字典保留旧 token
SECRET_KEY=${SECRET_KEY}

# === CORS / Security ===
# 占位符由 deploy-public.sh 在运行时替换为真实域名
CORS_ALLOWED_ORIGINS=https://${PUBLIC_DOMAIN}

# TrustedHostMiddleware 白名单（必须 JSON 数组格式，逗号分隔会被 pydantic 拒绝）
ALLOWED_HOSTS=["${PUBLIC_DOMAIN}"]

# === Trusted proxies (XFF / X-Real-IP) ===
# docker-compose.prod.yml 自定义网络 172.28.0.0/16；若 LB 在前面需追加 LB CIDR
TRUSTED_PROXY_CIDRS=172.28.0.0/16

# === Admin bootstrap (首次部署时临时开启 BOOTSTRAP_SEED_ADMIN=true) ===
BOOTSTRAP_SEED_ADMIN=false
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=${BOOTSTRAP_ADMIN_PASSWORD}

# === Dev escape hatches (生产必须 false) ===
DEV_ANON_ADMIN=false

# === Rate limit (收紧自默认 1800/60s) ===
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW=60

# === LLM provider chain (DashScope → DeepSeek → Xunfei → Ollama 降级) ===
DASHSCOPE_API_KEY=${DASHSCOPE_API_KEY}
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/api/v1
DASHSCOPE_MODEL=qwen-plus

DEEPSEEK_API_KEY=${DEEPSEEK_API_KEY}
DEEPSEEK_HTTP_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

XUNFEI_API_KEY=${XUNFEI_API_KEY}
XUNFEI_API_SECRET=${XUNFEI_API_SECRET}
XUNFEI_APP_ID=${XUNFEI_APP_ID}
SPARK_HTTP_URL=https://spark-api.xf-yun.com/v3.1/chat
SPARK_X_URL=https://spark-api.xf-yun.com/v4.0/chat
SPARK_X_MODEL=4.0Ultra

# === Ollama 本地兜底（公网部署应启用） ===
QWEN_MODEL_PATH=http://ollama:11434
QWEN_MODEL_NAME=qwen2.5:7b

# === TLS notes ===
# P0-F3 fix: Neo4j bolt+s TLS via docker-compose.prod.yml + certs mounted in /ssl/
# No longer need insecure TLS bypass.
