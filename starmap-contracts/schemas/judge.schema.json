        "avg_f1": {
          "default": 0.0,
          "description": "平均 F1",
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Avg F1",
          "type": "number"
        },
        "weighted_score": {
          "default": 0.0,
          "description": "加权总分",
          "title": "Weighted Score",
          "type": "number"
        },
        "f1_distribution": {
          "additionalProperties": {
            "type": "integer"
          },
          "description": "F1 分布",
          "title": "F1 Distribution",
          "type": "object"
        },
        "quality_gate": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
