    "BatchJudgeResponse": {
      "description": "批量评估汇总.",
      "properties": {
        "total_samples": {
          "default": 0,
          "description": "总样本数",
          "minimum": 0,
          "title": "Total Samples",
          "type": "integer"
        },
        "evaluated_samples": {
          "default": 0,
          "description": "实际评估样本数",
          "minimum": 0,
          "title": "Evaluated Samples",
          "type": "integer"
        },
        "avg_precision": {
          "default": 0.0,
          "description": "平均精确率",
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Avg Precision",
          "type": "number"
