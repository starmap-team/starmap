        "use_llm_judge": {
          "default": false,
          "description": "是否启用 LLM judge 进行多维度评分",
          "title": "Use Llm Judge",
          "type": "boolean"
        },
        "judge_prompt_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Judge prompt 版本号 (v1/v2), 默认使用 active 版本",
          "title": "Judge Prompt Version"
        }
