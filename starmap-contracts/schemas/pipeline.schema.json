{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "StarMap pipeline schemas",
  "description": "Auto-generated from backend/app/schemas/pipeline.py",
  "definitions": {
    "StageInfo": {
      "description": "Single pipeline stage details.",
      "properties": {
        "name": {
          "description": "Stage name",
          "title": "Name",
          "type": "string"
        },
        "status": {
          "description": "pending/running/completed/failed/skipped/cancelled",
          "title": "Status",
          "type": "string"
        },
        "started_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "ISO timestamp",
          "title": "Started At"
        },
        "completed_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "ISO timestamp",
          "title": "Completed At"
        },
        "progress": {
          "default": 0.0,
          "description": "Stage progress 0.0-1.0",
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Progress",
          "type": "number"
        },
        "duration_ms": {
          "default": 0,
          "description": "阶段耗时（毫秒）",
          "minimum": 0,
          "title": "Duration Ms",
          "type": "integer"
        },
        "records_processed": {
          "default": 0,
          "description": "已处理记录数",
          "minimum": 0,
          "title": "Records Processed",
          "type": "integer"
        },
        "records_new": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "crawl 真正新增行数",
          "title": "Records New"
        },
        "records_duplicate": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "crawl 重复行数",
          "title": "Records Duplicate"
        },
        "errors": {
          "description": "阶段错误信息列表",
          "items": {
            "type": "string"
          },
          "title": "Errors",
          "type": "array"
        },
        "errors_count": {
          "default": 0,
          "description": "Count of errors (alias for len(errors))",
          "minimum": 0,
          "title": "Errors Count",
          "type": "integer"
        },
        "warnings": {
          "description": "阶段非致命警告（如 crawl 0 条采集），不判 failed",
          "items": {
            "type": "string"
          },
          "title": "Warnings",
          "type": "array"
        },
        "retry_count": {
          "default": 0,
          "description": "阶段重试次数",
          "minimum": 0,
          "title": "Retry Count",
          "type": "integer"
        },
        "depends_on": {
          "description": "前置阶段名列表",
          "items": {
            "type": "string"
          },
          "title": "Depends On",
          "type": "array"
        },
        "current_activity": {
          "default": "",
          "description": "当前活动描述 (e.g. '正在爬取 BOSS直聘: ...')",
          "title": "Current Activity",
          "type": "string"
        },
        "recent_samples": {
          "description": "最近处理的样本 (URL/技能/图节点)",
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Recent Samples",
          "type": "array"
        },
        "sub_breakdown": {
          "additionalProperties": {
            "type": "integer"
          },
          "description": "子项分解 (e.g. {'bosszhipin': 12, '51job': 5})",
          "title": "Sub Breakdown",
          "type": "object"
        },
        "elapsed_ms": {
          "default": 0,
          "description": "已运行毫秒数",
          "minimum": 0,
          "title": "Elapsed Ms",
          "type": "integer"
        }
      },
      "required": [
        "name",
        "status"
      ],
      "title": "StageInfo",
      "type": "object"
    },
    "PipelineRunResponse": {
      "description": "Pipeline run details.",
      "properties": {
        "id": {
          "description": "流水线运行 ID",
          "title": "Id",
          "type": "string"
        },
        "run_type": {
          "description": "full | incremental",
          "title": "Run Type",
          "type": "string"
        },
        "status": {
          "description": "running/completed/failed/cancelled",
          "title": "Status",
          "type": "string"
        },
        "started_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "ISO 时间戳",
          "title": "Started At"
        },
        "completed_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "ISO 时间戳",
          "title": "Completed At"
        },
        "stages": {
          "description": "阶段详情列表",
          "items": {
            "$ref": "#/$defs/StageInfo"
          },
          "title": "Stages",
          "type": "array"
        },
        "total_records": {
          "default": 0,
          "description": "总记录数",
          "minimum": 0,
          "title": "Total Records",
          "type": "integer"
        },
        "new_records": {
          "default": 0,
          "description": "新增记录数",
          "minimum": 0,
          "title": "New Records",
          "type": "integer"
        },
        "updated_records": {
          "default": 0,
          "description": "更新记录数",
          "minimum": 0,
          "title": "Updated Records",
          "type": "integer"
        },
        "quality_score": {
          "default": 0.0,
          "title": "Quality Score",
          "type": "number"
        },
        "error_log": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error Log"
        },
        "selected_stages": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Selected Stages"
        },
        "selected_sources": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Selected Sources"
        }
      },
      "required": [
        "id",
        "run_type",
        "status"
      ],
      "title": "PipelineRunResponse",
      "type": "object"
    },
    "PipelineStatusResponse": {
      "description": "Global pipeline status overview.",
      "properties": {
        "is_running": {
          "default": false,
          "title": "Is Running",
          "type": "boolean"
        },
        "current_run": {
          "anyOf": [
            {
              "$ref": "#/$defs/PipelineRunResponse"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "last_run": {
          "anyOf": [
            {
              "$ref": "#/$defs/PipelineRunResponse"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "recent_failed_run": {
          "anyOf": [
            {
              "$ref": "#/$defs/PipelineRunResponse"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "run_counts": {
          "additionalProperties": {
            "type": "integer"
          },
          "title": "Run Counts",
          "type": "object"
        },
        "active_data_sources": {
          "default": 0,
          "title": "Active Data Sources",
          "type": "integer"
        },
        "today_crawl_volume": {
          "default": 0,
          "description": "今日爬虫处理量（各 run crawl 处理量之和，含重复）",
          "minimum": 0,
          "title": "Today Crawl Volume",
          "type": "integer"
        },
        "today_crawl_new": {
          "default": 0,
          "description": "今日 jd_raw 实际新增行数",
          "minimum": 0,
          "title": "Today Crawl New",
          "type": "integer"
        },
        "total_jd_raw": {
          "default": 0,
          "description": "jd_raw 全表行数（历史累计）",
          "minimum": 0,
          "title": "Total Jd Raw",
          "type": "integer"
        },
        "last_crawl_at": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "ISO timestamp of most recent crawl",
          "title": "Last Crawl At"
        },
        "success_rate": {
          "default": 0.0,
          "description": "7-day completed/(completed+failed)",
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Success Rate",
          "type": "number"
        },
        "avg_quality_score": {
          "default": 0.0,
          "description": "7-day avg quality_score",
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Avg Quality Score",
          "type": "number"
        },
        "quality_alerts": {
          "items": {
            "$ref": "#/$defs/QualityAlertItem"
          },
          "title": "Quality Alerts",
          "type": "array"
        }
      },
      "title": "PipelineStatusResponse",
      "type": "object"
    },
    "DataQualityResponse": {
      "description": "Data quality metrics and alerts.",
      "properties": {
        "metrics": {
          "$ref": "#/$defs/DataQualityMetrics"
        },
        "source_scores": {
          "additionalProperties": {
            "type": "number"
          },
          "title": "Source Scores",
          "type": "object"
        },
        "alerts": {
          "items": {
            "$ref": "#/$defs/QualityAlertItem"
          },
          "title": "Alerts",
          "type": "array"
        },
        "alert_count": {
          "default": 0,
          "title": "Alert Count",
          "type": "integer"
        }
      },
      "title": "DataQualityResponse",
      "type": "object"
    }
  },
