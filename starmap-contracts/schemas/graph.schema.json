{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "StarMap graph schemas",
  "description": "Auto-generated from backend/app/schemas/graph.py",
  "definitions": {
    "GraphNode": {
      "description": "通用图谱节点。\n\n对应 Neo4j 中的任意节点类型。",
      "properties": {
        "id": {
          "description": "节点稳定 ID",
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "labels": {
          "description": "Neo4j 节点标签列表",
          "examples": [
            [
              "Position"
            ],
            [
              "Skill",
              "Tool"
            ]
          ],
          "items": {
            "type": "string"
          },
          "title": "Labels",
          "type": "array"
        },
        "properties": {
          "type": "object",
          "additionalProperties": true,
          "description": "节点属性键值对",
          "title": "Properties"
        }
      },
      "required": [
        "id"
      ],
      "title": "GraphNode",
      "type": "object"
    },
    "GraphEdge": {
      "description": "通用图谱边。",
      "properties": {
        "source_id": {
          "description": "源节点 ID",
          "minLength": 1,
          "title": "Source Id",
          "type": "string"
        },
        "target_id": {
          "description": "目标节点 ID",
          "minLength": 1,
          "title": "Target Id",
          "type": "string"
        },
        "type": {
          "description": "关系类型",
          "examples": [
            "REQUIRES",
            "EVOLVES_TO",
            "BELONGS_TO"
          ],
          "minLength": 1,
          "title": "Type",
          "type": "string"
        },
        "properties": {
          "type": "object",
          "additionalProperties": true,
          "description": "边属性键值对",
          "title": "Properties"
        }
      },
      "required": [
        "source_id",
        "target_id",
        "type"
      ],
      "title": "GraphEdge",
      "type": "object"
    },
    "GraphOverviewResponse": {
      "description": "图谱全局概览。\n\n用于仪表盘首页展示图谱统计信息。",
      "properties": {
        "total_nodes": {
          "description": "图谱总节点数",
          "minimum": 0,
          "title": "Total Nodes",
          "type": "integer"
        },
        "total_edges": {
          "description": "图谱总边数",
          "minimum": 0,
          "title": "Total Edges",
          "type": "integer"
        },
        "total_positions": {
          "description": "岗位节点数",
          "minimum": 0,
          "title": "Total Positions",
          "type": "integer"
        },
        "total_skills": {
          "description": "技能节点数",
          "minimum": 0,
          "title": "Total Skills",
          "type": "integer"
        },
        "total_domains": {
          "description": "知识域节点数",
          "minimum": 0,
          "title": "Total Domains",
          "type": "integer"
        },
        "trust_score": {
          "default": 0.0,
          "description": "全局可信度评分 [0, 1]",
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Trust Score",
          "type": "number"
        },
        "hallucination_rate": {
          "default": 0.0,
          "description": "全局幻觉率 [0, 1]",
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Hallucination Rate",
          "type": "number"
        },
        "pipeline_status": {
          "default": "idle",
          "description": "数据管线状态",
          "title": "Pipeline Status",
          "type": "string"
        },
        "timestamp": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "数据快照时间",
          "title": "Timestamp"
        }
      },
      "required": [
        "total_nodes",
        "total_edges",
        "total_positions",
        "total_skills",
        "total_domains"
      ],
      "title": "GraphOverviewResponse",
      "type": "object"
    },
    "DomainOverviewItem": {
      "description": "领域概览中的单个 KA 节点。",
      "properties": {
        "id": {
          "description": "知识域节点 ID",
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "name": {
          "description": "知识域名称",
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "position_count": {
          "default": 0,
          "description": "关联岗位数",
          "minimum": 0,
          "title": "Position Count",
          "type": "integer"
        },
        "skill_count": {
          "default": 0,
          "description": "关联技能数",
          "minimum": 0,
          "title": "Skill Count",
          "type": "integer"
        },
        "color": {
          "default": "",
          "description": "节点颜色",
          "title": "Color",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name"
      ],
      "title": "DomainOverviewItem",
      "type": "object"
    },
    "DomainOverviewResponse": {
      "description": "领域概览响应：KA 节点 + KA 间关联 + 独立节点统计。\n\n对应 GET /graph/overview 实际返回结构（原内联于路由，违反\nSchema 集中管理约定，2026-08-05 迁入）。",
      "properties": {
        "domains": {
          "description": "KA 节点列表",
          "items": {
            "$ref": "#/$defs/DomainOverviewItem"
          },
          "title": "Domains",
          "type": "array"
        },
        "connections": {
          "description": "KA 间关联边",
          "items": {
            "$ref": "#/$defs/GraphEdge"
          },
          "title": "Connections",
          "type": "array"
        },
        "total_positions": {
          "default": 0,
          "description": "岗位总数",
          "minimum": 0,
          "title": "Total Positions",
          "type": "integer"
        },
        "total_skills": {
          "default": 0,
          "description": "技能总数",
          "minimum": 0,
          "title": "Total Skills",
          "type": "integer"
        },
        "independent_positions": {
          "default": 0,
          "description": "独立 Position 节点数（去重）",
          "minimum": 0,
          "title": "Independent Positions",
          "type": "integer"
        },
        "independent_skills": {
          "default": 0,
          "description": "独立 Skill 节点数（去重）",
          "minimum": 0,
          "title": "Independent Skills",
          "type": "integer"
        },
        "independent_edges": {
          "default": 0,
          "description": "独立 REQUIRES 关系数（去重）",
          "minimum": 0,
          "title": "Independent Edges",
          "type": "integer"
        }
      },
      "title": "DomainOverviewResponse",
      "type": "object"
    },
    "GraphPositionNode": {
      "description": "图域岗位扁平节点（Neo4j Position 序列化产物）。\n\n与 position.PositionNode 不同：skills_required 为 Neo4j 属性原始\ndict 列表（无规范子结构），且无 PG 侧的 discovered_at/review_status。\n原内联于 graph 路由，违反 Schema 集中管理约定，2026-08-05 迁入。",
      "properties": {
        "position_id": {
          "default": "",
          "description": "岗位唯一标识",
          "title": "Position Id",
          "type": "string"
        },
        "name": {
          "default": "",
          "description": "岗位名称",
          "title": "Name",
          "type": "string"
        },
        "name_cn": {
          "default": "",
          "description": "岗位中文名称",
          "title": "Name Cn",
          "type": "string"
        },
        "industry": {
          "default": "",
          "description": "所属行业",
          "title": "Industry",
          "type": "string"
        },
        "description": {
          "default": "",
          "description": "岗位描述",
          "title": "Description",
          "type": "string"
        },
        "skills_required": {
          "description": "岗位所需技能（Neo4j 属性原始 dict 列表）",
          "items": {
            "additionalProperties": true,
            "type": "object"
          },
          "title": "Skills Required",
          "type": "array"
        }
      },
      "title": "GraphPositionNode",
      "type": "object"
    },
    "GraphSkillNode": {
      "description": "图域技能扁平节点（Neo4j Skill 节点 + REQUIRES 关系序列化产物）。\n\n与 position.SkillNode 不同：额外携带 proficiency/trend/importance\n（源自关系属性 level/required 的归一化结果）。\n原内联于 graph 路由，违反 Schema 集中管理约定，2026-08-05 迁入。",
      "properties": {
        "skill_id": {
          "description": "技能唯一标识",
          "minLength": 1,
          "title": "Skill Id",
          "type": "string"
        },
        "name": {
          "description": "技能名称",
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "category": {
          "default": "hard_skill",
          "description": "技能分类",
          "title": "Category",
          "type": "string"
        },
        "proficiency": {
          "default": "熟悉",
          "description": "熟练度",
          "title": "Proficiency",
          "type": "string"
        },
        "confidence": {
          "default": 1.0,
          "description": "置信度",
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        },
        "source_count": {
          "default": 0,
          "description": "来源文档计数",
          "minimum": 0,
          "title": "Source Count",
          "type": "integer"
        },
        "trend": {
          "default": "stable",
          "description": "趋势方向",
          "title": "Trend",
          "type": "string"
        },
        "importance": {
          "default": "required",
          "description": "required/bonus",
          "title": "Importance",
          "type": "string"
        }
      },
      "required": [
        "skill_id",
        "name"
      ],
      "title": "GraphSkillNode",
      "type": "object"
    },
    "KAPositionsResponse": {
      "description": "单个 KA 下的 Position 列表 + 关联 Skill 边。\n\n对应 GET /graph/ka/{ka_id}/positions。原内联于 graph 路由，违反\nSchema 集中管理约定，2026-08-05 迁入。",
      "properties": {
        "ka_id": {
          "default": "",
          "description": "KA 节点 ID 或模式字面量（ts-/lv-/heat-/ind-）",
          "title": "Ka Id",
          "type": "string"
        },
        "ka_name": {
          "default": "",
          "description": "KA 名称（用于展示）",
          "title": "Ka Name",
          "type": "string"
        },
        "positions": {
          "description": "Position 节点列表",
          "items": {
            "$ref": "#/$defs/GraphNode"
          },
          "title": "Positions",
          "type": "array"
        },
        "position_skill_edges": {
          "description": "Position-REQUIRES-Skill 边列表",
          "items": {
            "$ref": "#/$defs/GraphEdge"
          },
          "title": "Position Skill Edges",
          "type": "array"
        },
        "skills": {
          "description": "关联的 Skill 节点",
          "items": {
            "$ref": "#/$defs/GraphNode"
          },
          "title": "Skills",
          "type": "array"
        }
      },
      "title": "KAPositionsResponse",
      "type": "object"
    },
    "PositionSkillDetailResponse": {
      "description": "岗位技能子图响应：position + skills 扁平列表 + REQUIRES 边。\n\n以 GET /graph/position/{position_id}/skills 真实返回为准（前端\nmatch/jd store 均按 {position, skills, edges} 消费）。旧契约含\npaths 字段与真实 API 漂移，2026-08-05 对齐修正。",
      "properties": {
        "position": {
          "anyOf": [
            {
              "$ref": "#/$defs/GraphPositionNode"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "岗位信息"
        },
        "skills": {
          "description": "技能节点列表",
          "items": {
            "$ref": "#/$defs/GraphSkillNode"
          },
          "title": "Skills",
          "type": "array"
        },
        "edges": {
          "description": "技能关系边列表",
          "items": {
            "$ref": "#/$defs/GraphEdge"
          },
          "title": "Edges",
          "type": "array"
        }
      },
      "title": "PositionSkillDetailResponse",
      "type": "object"
    }
  },
