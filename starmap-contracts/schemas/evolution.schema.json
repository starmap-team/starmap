          "minimum": 0,
          "title": "D",
          "type": "integer"
        },
        "p_value": {
          "description": "Fisher 精确检验 p 值",
          "maximum": 1,
          "minimum": 0,
          "title": "P Value",
          "type": "number"
        },
        "significant": {
          "description": "p < 0.05 且 |phi| >= 0.1",
          "title": "Significant",
          "type": "boolean"
