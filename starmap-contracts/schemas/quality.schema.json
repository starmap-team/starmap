        "dimension": {
          "description": "质量维度",
          "minLength": 1,
          "title": "Dimension",
          "type": "string"
        },
        "value": {
          "description": "当前值",
          "title": "Value",
          "type": "number"
        },
        "threshold": {
          "description": "阈值",
          "title": "Threshold",
          "type": "number"
        },
        "status": {
          "description": "pass/warn/fail",
