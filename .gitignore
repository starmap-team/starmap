# ==================== StarMap .gitignore ====================
# ---- 环境变量（含密钥，绝不提交）----
.env
.env.local
.env.*.local
!.env.example
# NEW-P0 fix (AUDIT_VERIFICATION §1.4 C1): production env file holds real
# secrets — keep `.env.production` out of git but allow the safe template.
.env.production
!.env.production.example
# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
# 虚拟环境
venv/
env/
ENV/
.venv/
# 测试覆盖率
htmlcov/
.tox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
.pytest_cache/
.mypy_cache/
.ruff_cache/
# Poetry
# poetry.lock 应该提交（锁定依赖，规范3）
