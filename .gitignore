# ==================== StarMap .gitignore ====================
# 全面排除规则 — 按类别分区，每区一个职责
# 规则：已跟踪的文件不受 gitignore 影响；如需停止跟踪，先 git rm --cached
# ================================================================

# ---- 环境变量（含密钥，绝不提交）----
.env
.env.local
.env.*.local
!.env.example
.env.production
!.env.production.example
.env.docker
*.env.docker
.env.bak
secrets/

# ---- Python 编译/发布产物 ----
__pycache__/
*.py[cod]
*$py.class
*.so
.python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
*.manifest
*.spec

# ---- 虚拟环境 ----
venv/
env/
ENV/
.venv/
.venv-new/

# ---- 测试覆盖率 & 缓存 ----
htmlcov/
.tox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---- Poetry（poetry.lock 应该提交，锁定依赖）----

# ---- Node / 前端 ----
node_modules/
frontend/dist/
frontend/dist-ssr/
*.local
frontend/.local/
.vite/
frontend/coverage/
frontend/playwright-report/
frontend/test-results/
frontend/e2e/auth-state.json
frontend/e2e/__screenshots__/
frontend/gen_*.js
frontend/src/pages/*.vue.new
frontend/pencil-tools/
# 前端生成产物（从 starmap-contracts 生成，不进版本库）
frontend/src/api/schema.ts

# ---- IDE / 编辑器 ----
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ---- Docker / 服务本地数据卷 ----
# 注意：data/ 改为 /data/ 锚定到仓库根。原写法会同时匹配
# backend/app/data/（fixture seed 数据），导致该目录被忽略，
# tests/unit/test_fixture_seed.py 在 CI 中报 ModuleNotFoundError。
/data/
volumes/
neo4j/
pgdata/
redis-data/
rabbitmq-data/
celerybeat-schedule*
celerybeat.pid

# ---- 日志 ----
*.log
logs/
dev.log
vite.log
vite_output.log

# ---- 临时 / 备份文件 ----
*.tmp
*.bak
*~
# filter-repo / filter-branch 重写残留
.git-rewrite/

# ---- 调试 / 诊断临时文件 ----
_backend*.txt
_*.log
debug-*.log
.tmp_*
req.json
test_resp.json
test_*.json

# ---- 临时脚本（根目录一次性使用）----
git_*.bat
git_*.ps1
cleanup.ps1
_e2e_test.py
_crawl_phase2.py
get_token.py

# ---- 临时 Python 脚本（诊断/patch/expand）----
_patch_*.py
_expand_*.py
backend/_*.py
backend/_*.json
backend/_*.txt
tmp_*.py

# ---- 根目录/backend 一次性测试脚本（正经测试在 tests/ 下）----
# 锚定根级，避免误伤 backend/tests/** 下的正规测试
/test_*.py
backend/test_*.py
/check_*.py

# ---- Agent / AI 工具运行时目录 ----
.claude/
.claude-flow/
.playwright-mcp/
.codegraph/
.omc/
.omo/
.serena/
.reasonix/
graphify-out/
screenshots/
.zcode/
.workbuddy/
# .planning 整体忽略（开发过程产物，不进版本库）
.planning/
backend/.planning/
# plans/ 规划蓝图（开发过程产物）
plans/

# ---- Playwright / E2E 测试产物 ----
playwright-report/
test-results/
tests/e2e/browser-qa/
tests/e2e/playwright_smoke/
tests/e2e/integration-results/
tests/e2e/browser_qa_screenshots/
tests/e2e/browser_qa_match_extract/
tests/e2e/browser_qa_cycle/
tests/e2e/browser_toolbar_test/
tests/e2e/browser_interaction/
tests/e2e/browser_smoke/
tests/e2e/screenshot_*.png
tests/e2e/**/*.png
tests/e2e/full_e2e_results.json
tests/e2e/investigations/

# ---- Vite/Vitest 临时文件 ----
vitest.config.ts.timestamp-*.mjs

# ---- 文档 / 归档区域 ----
docs/archive/
docs/pencil-tools/
CLAUDE.md
.github/AGENTS.md

# ---- 评估运行时产物（代码与 golden_set*.jsonl 保留）----
# DEV-05: baseline/real_eval 报告按计划书裁决提交入库（评估证据），仅排除运行时中间产物
evaluation/baseline_report/*
!evaluation/baseline_report/
evaluation/llm_real_report/
evaluation/llm_sim_report/
evaluation/real_eval_report/*
!evaluation/real_eval_report/
evaluation/demo_evidence/
evaluation/system_llm_*.jsonl
evaluation/match_accuracy_report.json

# ---- scripts/ 一次性诊断脚本（保留 seed_*/validate_*/check-* 等正经脚本）----
scripts/fix_graph_data.py
scripts/fix_graph_*.py
backend/scripts/seed_changelog.py

# ---- 截图 / 图片产物 ----
_*.png
_*.jpg
test-screenshots/
screenshots/

# ---- Windows NUL 设备误生成 ----
nul

# ---- 压缩包产物（仅排除构建/备份压缩包，不遗漏合法 .zip）----
starmap.zip

# ---- 幽灵目录（审计发现，防止意外闯入）----
starmap/
test_ignored.py

# ---- 一次性诊断/探测产物（调试输出，严禁入库，其中可能含 token）----
docker_now.txt
docker_svc.txt
docker_svc2.txt
env_health.txt
env_probe.txt
kill.txt
login_check.txt
match3.txt
match4.txt
match5.txt
match_test.txt
match_test2.txt
port2.txt
port_check.txt
ports.txt
ports2.txt
proxy2.txt
