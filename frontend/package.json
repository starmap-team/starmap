{
  "name": "starmap-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit -p tsconfig.app.json && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint . --ext .vue,.ts,.tsx --max-warnings 50",
    "lint:fix": "eslint . --ext .vue,.ts,.tsx --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "gen:api": "openapi-typescript ../starmap-contracts/openapi.yaml -o src/api/schema.ts",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@antv/g6": "5.1.1",
    "@element-plus/icons-vue": "2.3.2",
    "3d-force-graph": "^1.80.0",
    "axios": "1.17.0",
    "echarts": "^5.6.0",
    "element-plus": "2.14.2",
    "pinia": "3.0.4",
    "three": "^0.185.1",
    "vue": "3.5.38",
    "vue-echarts": "6.7.3",
    "vue-router": "4.6.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^20.11.0",
    "@types/three": "^0.185.0",
    "@typescript-eslint/eslint-plugin": "^7.3.0",
    "@typescript-eslint/parser": "^7.3.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "@vitest/coverage-v8": "^2.1.9",
    "@vue/test-utils": "^2.4.0",
    "eslint": "^8.57.0",
    "eslint-plugin-vue": "^9.23.0",
    "jsdom": "^24.0.0",
    "openapi-typescript": "^7.13.0",
    "playwright": "^1.61.1",
    "sass": "^1.72.0",
    "typescript": "^5.4.0",
    "vite": "^6.4.3",
    "vitest": "^2.1.9",
    "vue-eslint-parser": "^9.4.0",
    "vue-tsc": "^2.0.0"
  }
}
