# ==================== StarMap .env.example — Canonical Reference ====================
# DO NOT put real secrets in this file. Copy → .env (or backend/.env) and edit.
#
# StarMap supports THREE run modes. Each mode loads env from a different file:
#   1. `docker compose ... up`  ───────── uses  `.env`           (this dir)
#   2. Host backend + Docker DB ──────── uses  `backend/.env`    (this dir)
#   3. Production compose ────────────── uses  `.env`           (this dir, prod overrides)
#
# For convenience, .env (Docker mode) and backend/.env (host mode) are committed
# in the repo with SAFE development defaults so you can `docker compose up` or
# `poetry run uvicorn` immediately. Override only what you need.

# ════════════════════════════════════════════════════════════
# Database
# ════════════════════════════════════════════════════════════
# In Docker compose: POSTGRES_HOST=postgres, NEO4J_URI=bolt://neo4j:7687, …
# In host mode:      POSTGRES_HOST=localhost, POSTGRES_PORT=5433, …

POSTGRES_USER=starmap
POSTGRES_PASSWORD=CHANGE_ME_IN_ENV
POSTGRES_HOST=postgres        # change to localhost for host-mode
POSTGRES_PORT=5432            # change to 5433 for host-mode on Windows
POSTGRES_DB=starmap

NEO4J_URI=bolt://neo4j:7687   # change to bolt://localhost:7687 for host-mode
NEO4J_USER=neo4j
NEO4J_PASSWORD=CHANGE_ME_IN_ENV

REDIS_URI=redis://redis:6379/0   # host mode: redis://localhost:6379/0

CHROMA_HOST=chroma            # host mode: localhost
CHROMA_PORT=8000              # host mode: 8001

# ════════════════════════════════════════════════════════════
# LLM (降级链：MiMo → DeepSeek → 星火 → Ollama 本地兜底)
# ════════════════════════════════════════════════════════════
MIMO_API_BASE=https://token-plan-cn.xiaomimimo.com/v1
MIMO_API_KEY=

DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_API_KEY=

XUNFEI_API_KEY=
XUNFEI_API_SECRET=
XUNFEI_APP_ID=

# 本地模型（Docker 容器 ollama；主机模式改为 http://localhost:11434）
QWEN_MODEL_PATH=http://ollama:11434

# ════════════════════════════════════════════════════════════
# Application
# ════════════════════════════════════════════════════════════
APP_ENV=development          # production sets APP_ENV=production
APP_DEBUG=true               # MUST be false in production
APP_LOG_LEVEL=INFO

# [必改] 32+ 字符随机密钥；用 `python -c "import secrets; print(secrets.token_urlsafe(32))"` 生成
SECRET_KEY=CHANGE_ME_IN_ENV

# ════════════════════════════════════════════════════════════
# Bootstrap (DB seed in entrypoint)
# ════════════════════════════════════════════════════════════
# `docker compose -f docker-compose.dev.yml up` 会自动跑 entrypoint.sh →
# bootstrap.py → alembic upgrade + 可选 seed admin。生产严禁设为 true。
BOOTSTRAP_SEED_ADMIN=false
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=starmap2024

# ════════════════════════════════════════════════════════════
# Frontend (Vite)
# ════════════════════════════════════════════════════════════
# Browser → vite dev server (5173) → this URL → backend
# Docker mode:  http://localhost:8000 (browser hits host backend through compose port mapping)
# Host mode:    http://localhost:8000
VITE_API_BASE_URL=http://localhost:8000

# ════════════════════════════════════════════════════════════
# ❌ REMOVED in Phase DB-AUTH — users are now in PostgreSQL `users` table
# ════════════════════════════════════════════════════════════
# AUTH_USERS=admin:starmap2024:admin,demo:demo123:user      ← GONE
# Use the admin UI (User Management tab) or POST /api/v1/admin/users to manage users.
