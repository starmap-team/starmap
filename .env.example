# ==================== 星图(StarMap) 环境变量模板 ====================
# 用法：cp .env.example .env  然后填入真实值
# 注意：.env 文件不要提交到 git（已在 .gitignore 中）
#
# ⚠️  安全提醒：
#     1. 所有标记为 [必改] 的密码/密钥字段，部署前必须在 .env 中设置真实值
#     2. 绝不要将 .env 文件提交到 git — 包含 API 密钥等敏感信息
#     3. SECRET_KEY 必须使用随机生成的强密钥（见下方生成方式）
#     4. 生产环境数据库密码必须使用强密码，不要使用示例值

# ---------- 数据库 ----------
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
# [必改] Neo4j 密码，请替换为强密码
NEO4J_PASSWORD=CHANGE_ME_IN_ENV

# PostgreSQL 连接——支持两种方式（二选一）：
#   方式 A：通过组件拼接（推荐，更清晰）
POSTGRES_USER=starmap
# [必改] PostgreSQL 密码，请替换为强密码
POSTGRES_PASSWORD=CHANGE_ME_IN_ENV
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=starmap
#   方式 B：直接传入完整 URI（设置后优先于组件拼接）
# POSTGRES_URI=postgresql+asyncpg://starmap:your_strong_password@postgres:5432/starmap

REDIS_URI=redis://redis:6379/0

CHROMA_HOST=chroma
CHROMA_PORT=8000

# ---------- LLM ----------
# 讯飞星火 API（核心抽取，必填，全员共享配额）
XUNFEI_API_KEY=
XUNFEI_API_SECRET=
XUNFEI_APP_ID=

# Qwen2.5-7B 本地模型（通过 docker-compose 中 Ollama 服务提供）
# 默认指向容器内 Ollama 服务；宿主机调试时改为 http://localhost:11434
QWEN_MODEL_PATH=http://ollama:11434

# ---------- 应用 ----------
APP_ENV=development
APP_DEBUG=true
APP_LOG_LEVEL=INFO
# [必改] 应用密钥，用于 JWT 签名等安全操作，请替换为随机长字符串
# 生成方式：python -c "import secrets; print(secrets.token_urlsafe(32))"
# ⚠️ 绝不要使用 "dev_secret"、"changeme" 等可预测值！
SECRET_KEY=CHANGE_ME_IN_ENV

# ---------- 前端 ----------
VITE_API_BASE_URL=http://localhost:8000
