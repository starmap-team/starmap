# StarMap environment template
# Copy to .env for development. Never put real credentials in git.
# Production uses a separately managed .env.production file.
#
# Development compose: PostgreSQL/Neo4j/Redis + backend/frontend/worker.
# Optional Ollama: docker compose -f docker-compose.dev.yml --profile llm up -d ollama ollama-pull
# ChromaDB is not part of the development compose; production may enable it.

POSTGRES_USER=starmap
POSTGRES_PASSWORD=CHANGE_ME_IN_ENV
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=starmap
POSTGRES_SSLMODE=prefer

NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=CHANGE_ME_IN_ENV

REDIS_URI=redis://redis:6379/0
REDIS_PASSWORD=starmap_dev_redis  # Redis 密码（dev 默认；生产必须覆盖）

# Only used by production Compose or an explicitly configured vector service.
CHROMA_HOST=chroma
CHROMA_PORT=8000

# LLM fallback chain: DashScope(Qwen) -> Spark X -> MiMo(可选) -> DeepSeek -> Xunfei -> local Ollama.
# 阿里云百炼 Qwen（2026-08-14 起降级链首选；OpenAI 兼容端点）
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://llm-nire844xse41iz9w.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen-plus
# Spark X 深度推理（X2 默认，X1.5 改 SPARK_X_URL）：model 固定 spark-x
SPARK_X_URL=https://spark-api-open.xf-yun.com/x2/chat/completions
SPARK_X_MODEL=spark-x
# MiMo 需要讯飞星辰 MaaS Key（maas-coding-api 端点）；无 Key 可移除。
# MIMO_API_BASE=https://maas-coding-api.cn-huabei-1.xf-yun.com/v2
# MIMO_API_KEY=
# MIMO_MODEL=astron-code-latest
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_API_KEY=
DEEPSEEK_HTTP_URL=https://api.deepseek.com/chat/completions
XUNFEI_API_KEY=
XUNFEI_API_SECRET=
XUNFEI_APP_ID=
SPARK_HTTP_URL=https://spark-api-open.xf-yun.com/v1/chat/completions
QWEN_MODEL_PATH=http://ollama:11434
QWEN_MODEL_NAME=qwen2.5:7b

APP_ENV=development
APP_DEBUG=true
APP_LOG_LEVEL=INFO
SECRET_KEY=CHANGE_ME_IN_ENV

# Development convenience only. Production must keep this false and use explicit user creation.
BOOTSTRAP_SEED_ADMIN=false
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_IN_ENV
DEV_ANON_ADMIN=false

# XFF 可信代理 CIDR（逗号分隔；空=拒绝伪造 XFF，限流将按代理 IP 聚合）
# 生产（docker compose 默认网段）：172.28.0.0/16
trusted_proxy_cidrs=

# Browser API base is a code constant: frontend/src/config/apiBase.ts -> /api/v1.
# Vite proxy target can be overridden only for local development.
VITE_API_PROXY_TARGET=http://localhost:8000
